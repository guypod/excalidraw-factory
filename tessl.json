{
  "name": "ws-01a163fa71c4754eb74e01d925aab797/excalidraw-factory",
  "mode": "managed",
  "dependencies": {
    "tessl-labs/factory-setup": {
      "version": "0.20.4"
    }
  },
  "agents": ["tessl-agent"],
  "actions": {
    "implement-github-issue": {
      "skill": "tessl-labs/factory#implement-github-issue",
      "environment": "excalidraw-factory-factory",
      "agent": "claude-code",
      "model": "claude-opus-5-5"
    },
    "follow-ticket-changes": {
      "skill": "tessl-labs/factory#follow-ticket-changes",
      "environment": "excalidraw-factory-factory",
      "agent": "codex",
      "model": "gpt-6-luna"
    },
    "shepherd": {
      "skill": "tessl-labs/factory#shepherd",
      "environment": "excalidraw-factory-factory",
      "agent": "claude-code",
      "model": "claude-opus-5-5"
    }
  },
  "triggers": {
    "github-issue-labelled": {
      "on": ["github:issues.labeled"],
      "when": {
        "event.label.name": "tessl",
        "event.sender.type": "User",
        "event.sender.id": 1106394,
        "event.issue.state": "open"
      },
      "concurrency": {
        "keys": [
          {
            "key": "implement:{{ event.repository.id }}#{{ event.issue.number }}",
            "limit": 1
          }
        ]
      },
      "action": "implement-github-issue"
    },
    "follow-ticket-changes-github-taken-back": {
      "on": ["github:issues.unlabeled"],
      "when": {
        "event.label.name": "tessl",
        "event.sender.id": 1106394
      },
      "concurrency": {
        "keys": [
          {
            "key": "follow-ticket-changes:{{ event.repository.id }}#{{ event.issue.number }}",
            "limit": 1
          }
        ]
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "taken-back"
        }
      }
    },
    "follow-ticket-changes-github-ended": {
      "on": ["github:issues.closed"],
      "when": {
        "event.issue.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.sender.id": 1106394
      },
      "concurrency": {
        "keys": [
          {
            "key": "follow-ticket-changes:{{ event.repository.id }}#{{ event.issue.number }}",
            "limit": 1
          }
        ]
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "issue-ended"
        }
      }
    },
    "follow-ticket-changes-github-replied": {
      "on": ["github:issue_comment.created"],
      "when": {
        "isPullRequest": "false",
        "event.issue.state": "open",
        "event.issue.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.sender.id": 1106394
      },
      "concurrency": {
        "keys": [
          {
            "key": "implement:{{ event.repository.id }}#{{ event.issue.number }}",
            "limit": 1
          }
        ]
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "replied"
        }
      }
    },
    "follow-ticket-changes-pr-closed": {
      "on": ["github:pull_request.closed"],
      "when": {
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.sender.id": 1106394,
        "event.pull_request.head.repo.id": 1437575467
      },
      "concurrency": {
        "keys": [
          {
            "key": "follow-ticket-changes:{{ event.repository.id }}#{{ event.pull_request.number }}",
            "limit": 1
          }
        ]
      },
      "action": {
        "use": "follow-ticket-changes",
        "inputs": {
          "TICKET_CHANGE": "pr-closed"
        }
      }
    },
    "shepherd-pr-review": {
      "on": ["github:pull_request_review.submitted"],
      "when": {
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.head.repo.id": 1437575467,
        "event.pull_request.state": "open",
        "event.sender.id": 1106394
      },
      "concurrency": {
        "debounce": "90s",
        "keys": [
          {
            "key": "shepherd:{{ event.pull_request.number }}",
            "limit": 1
          }
        ]
      },
      "action": "shepherd"
    },
    "shepherd-pr-review-by-reviewer": {
      "on": ["github:pull_request_review.submitted"],
      "when": {
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.head.repo.id": 1437575467,
        "event.pull_request.state": "open",
        "event.sender.id": "{{ github.tesslReviewerApp.userId }}"
      },
      "concurrency": {
        "debounce": "90s",
        "keys": [
          {
            "key": "shepherd:{{ event.pull_request.number }}",
            "limit": 1
          }
        ]
      },
      "action": "shepherd"
    },
    "shepherd-pr-review-comment": {
      "on": ["github:pull_request_review_comment.created"],
      "when": {
        "event.pull_request.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.pull_request.head.ref": {
          "matches": "^tessl/"
        },
        "event.pull_request.head.repo.id": 1437575467,
        "event.pull_request.state": "open",
        "event.sender.id": 1106394
      },
      "concurrency": {
        "debounce": "90s",
        "keys": [
          {
            "key": "shepherd:{{ event.pull_request.number }}",
            "limit": 1
          }
        ]
      },
      "action": "shepherd"
    },
    "shepherd-pr-comment": {
      "on": ["github:issue_comment.created"],
      "when": {
        "isPullRequest": "true",
        "event.issue.labels.*.name": {
          "any": {
            "equals": "tessl"
          }
        },
        "event.issue.state": "open",
        "event.sender.id": 1106394
      },
      "concurrency": {
        "debounce": "90s",
        "keys": [
          {
            "key": "shepherd:{{ event.issue.number }}",
            "limit": 1
          }
        ]
      },
      "action": "shepherd"
    },
    "shepherd-checks-failed": {
      "on": ["github:check_run.completed"],
      "when": {
        "event.check_run.pull_requests.0.number": {
          "exists": true
        },
        "event.check_run.pull_requests.0.head.repo.id": 1437575467,
        "event.check_run.check_suite.head_branch": {
          "matches": "^tessl/"
        },
        "event.check_run.conclusion": {
          "in": ["failure", "timed_out", "startup_failure", "action_required"]
        }
      },
      "concurrency": {
        "debounce": "90s",
        "keys": [
          {
            "key": "shepherd:{{ event.check_run.pull_requests.0.number }}",
            "limit": 1
          }
        ]
      },
      "action": "shepherd"
    },
    "shepherd-checks-passed": {
      "on": ["github:check_suite.completed"],
      "when": {
        "event.check_suite.pull_requests.0.number": {
          "exists": true
        },
        "event.check_suite.pull_requests.0.head.repo.id": 1437575467,
        "event.check_suite.head_branch": {
          "matches": "^tessl/"
        },
        "event.check_suite.conclusion": "success"
      },
      "concurrency": {
        "debounce": "90s",
        "keys": [
          {
            "key": "shepherd:{{ event.check_suite.pull_requests.0.number }}",
            "limit": 1
          }
        ]
      },
      "action": "shepherd"
    }
  }
}
